#!/usr/bin/env bash
#
# f2ban-bans - list, filter, and unban banned IPs across all fail2ban jails
#
# Usage:
#   f2ban-bans                      # all banned IPs, grouped by jail
#   f2ban-bans -l                   # list active jails (e.g. to pick one for -j)
#   f2ban-bans -p 92.               # filter by pattern/regex (a prefix is enough)
#   f2ban-bans -p '92.*'            # shell-style pattern is auto-converted to regex
#   f2ban-bans -j sshd              # show only a specific jail
#   f2ban-bans -j sshd -p 92.       # combine jail + pattern
#   f2ban-bans -c                   # show only the count per jail
#   f2ban-bans -u 92.1.2.3          # unban this IP from every jail it's banned in
#   f2ban-bans -u 92.1.2.3 -j sshd  # unban this IP only from the given jail
#
# Output is automatically sorted (numerically by octet) and deduplicated.
# Colored output only when stdout is a terminal (no ANSI codes when piped/redirected).
#
# Must be run as root (fail2ban-client requires it).

# Guard: must not be sourced into an interactive shell
# (otherwise "set -u" stays active permanently and can kill the shell/SSH
# session - e.g. if this file accidentally ends up under /etc/bash_completion.d/).
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
    echo "This script must not be sourced - run it directly instead (e.g. f2ban-bans)." >&2
    # shellcheck disable=SC2317  # 'exit' is the fallback when not inside a sourced context
    return 1 2>/dev/null || exit 1
fi

set -euo pipefail

PATTERN=""
JAIL_FILTER=""
COUNT_ONLY=0
LIST_JAILS=0
UNBAN_IP=""

# Enable colors only when output goes to a terminal
if [[ -t 1 ]]; then
    C_RESET=$'\e[0m'
    C_BOLD=$'\e[1m'
    C_GREEN=$'\e[32m'
    C_YELLOW=$'\e[33m'
    C_RED=$'\e[31m'
    C_BLUE=$'\e[34m'
else
    C_RESET=""; C_BOLD=""; C_GREEN=""; C_YELLOW=""; C_RED=""; C_BLUE=""
fi

usage() {
    echo "Usage: $(basename "$0") [-p pattern] [-j jail] [-c] [-l] [-u IP] [-h]"
    echo
    echo "  -p PATTERN   Filter banned IPs by regex, e.g. '^92\.' or '92.*'"
    echo "  -j JAIL      Only show/use this jail instead of all jails"
    echo "  -c           Show only the number of banned IPs per jail"
    echo "  -l           Only list active jails, then exit"
    echo "  -u IP        Unban this IP (all jails, or only -j jail)"
    echo "  -h           Show this help"
    exit 1
}

while getopts ":p:j:clu:h" opt; do
    case "$opt" in
        p) PATTERN="$OPTARG" ;;
        j) JAIL_FILTER="$OPTARG" ;;
        c) COUNT_ONLY=1 ;;
        l) LIST_JAILS=1 ;;
        u) UNBAN_IP="$OPTARG" ;;
        h) usage ;;
        \?) echo "Unknown option: -$OPTARG" >&2; usage ;;
        :) echo "Option -$OPTARG requires an argument." >&2; usage ;;
    esac
done

if [[ "$(id -u)" -ne 0 ]]; then
    echo "This script must be run as root (use sudo)." >&2
    exit 1
fi

if ! command -v fail2ban-client >/dev/null 2>&1; then
    echo "fail2ban-client not found. Is fail2ban installed?" >&2
    exit 1
fi

ALL_JAILS="$(fail2ban-client status | sed -n 's/^.*Jail list:[[:space:]]*//p' | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | sed '/^$/d')"

if [[ "$LIST_JAILS" -eq 1 ]]; then
    echo "${C_BOLD}Active jails:${C_RESET}"
    while IFS= read -r jail_name; do
        echo "  $jail_name"
    done <<< "$ALL_JAILS"
    exit 0
fi

# Sort a list of IPv4 addresses numerically by octet and remove duplicates
sort_ips() {
    awk '!seen[$0]++' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n
}

# Converts a simple shell-style pattern like "92.*" into a usable regex.
normalize_pattern() {
    local p="$1"
    if [[ "$p" == *'*' ]]; then
        p="${p%\*}"
        p="^${p//./\\.}"
    fi
    echo "$p"
}

if [[ -n "$PATTERN" ]]; then
    PATTERN="$(normalize_pattern "$PATTERN")"
fi

if [[ -n "$JAIL_FILTER" ]]; then
    JAILS="$JAIL_FILTER"
else
    JAILS="$ALL_JAILS"
fi

# --- Unban an IP and exit ---
if [[ -n "$UNBAN_IP" ]]; then
    FOUND=0
    for jail in $JAILS; do
        [[ -z "$jail" ]] && continue
        if fail2ban-client set "$jail" unbanip "$UNBAN_IP" >/dev/null 2>&1; then
            echo "${C_GREEN}✓${C_RESET} $UNBAN_IP unbanned from jail '${C_BOLD}$jail${C_RESET}'"
            FOUND=1
        fi
    done
    if [[ "$FOUND" -eq 0 ]]; then
        echo "${C_RED}✗${C_RESET} $UNBAN_IP was not banned in any checked jail." >&2
        exit 1
    fi
    exit 0
fi

# --- Regular listing ---
TOTAL=0

for jail in $JAILS; do
    [[ -z "$jail" ]] && continue

    STATUS="$(fail2ban-client status "$jail" 2>/dev/null || true)"
    if [[ -z "$STATUS" ]]; then
        echo "Jail '$jail' not found, skipping." >&2
        continue
    fi

    IP_LINE="$(echo "$STATUS" | sed -n 's/^.*Banned IP list:[[:space:]]*//p')"

    if [[ -n "$PATTERN" ]]; then
        IPS="$(echo "$IP_LINE" | tr ' ' '\n' | sed '/^$/d' | grep -E "$PATTERN" || true)"
    else
        IPS="$(echo "$IP_LINE" | tr ' ' '\n' | sed '/^$/d')"
    fi

    if [[ -n "$IPS" ]]; then
        IPS="$(echo "$IPS" | sort_ips)"
    fi

    IP_COUNT=$(echo "$IPS" | sed '/^$/d' | wc -l)
    [[ -z "$IPS" ]] && IP_COUNT=0

    TOTAL=$((TOTAL + IP_COUNT))

    if [[ "$COUNT_ONLY" -eq 1 ]]; then
        printf "%-20s ${C_YELLOW}%d${C_RESET}\n" "$jail" "$IP_COUNT"
    else
        if [[ "$IP_COUNT" -gt 0 ]]; then
            echo "${C_BLUE}${C_BOLD}=== $jail ($IP_COUNT) ===${C_RESET}"
            echo "$IPS"
        fi
    fi
done

if [[ "$COUNT_ONLY" -eq 1 ]]; then
    echo "-----"
    printf "%-20s ${C_BOLD}%d${C_RESET}\n" "TOTAL" "$TOTAL"
elif [[ "$TOTAL" -eq 0 ]]; then
    echo "No banned IPs found (with the selected filters)."
fi
