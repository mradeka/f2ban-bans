#!/usr/bin/env bash
#
# f2ban-bans - listet gesperrte IPs aus allen fail2ban-Jails auf, filtert sie
#              und kann IPs direkt entsperren
#
# Verwendung:
#   f2ban-bans                  # alle gesperrten IPs, gruppiert nach Jail
#   f2ban-bans -l                # aktive Jails auflisten (z. B. zur Auswahl für -j)
#   f2ban-bans -p 92.           # nach Muster/Regex filtern (Präfix reicht)
#   f2ban-bans -p '92.*'        # Shell-Style-Muster wird automatisch in Regex umgewandelt
#   f2ban-bans -j sshd          # nur eine bestimmte Jail anzeigen
#   f2ban-bans -j sshd -p 92.   # Jail + Muster kombinieren
#   f2ban-bans -c               # nur Anzahl pro Jail anzeigen
#   f2ban-bans -u 92.1.2.3       # IP aus allen Jails entsperren, in denen sie gesperrt ist
#   f2ban-bans -u 92.1.2.3 -j sshd  # IP nur aus dieser Jail entsperren
#
# Ausgabe ist automatisch sortiert (numerisch nach Oktetten) und dedupliziert.
# Farbige Ausgabe nur, wenn stdout ein Terminal ist (kein ANSI-Müll bei Umleitung/Pipe).
#
# Muss als root laufen (fail2ban-client erfordert das).

# Schutz: darf nicht mit 'source'/'.' in eine interaktive Shell eingelesen werden
# (sonst bleibt "set -u" dauerhaft aktiv und kann die Shell/SSH-Session zerschießen,
# z. B. wenn diese Datei versehentlich unter /etc/bash_completion.d/ landet).
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
    echo "Dieses Script darf nicht mit 'source' aufgerufen werden - bitte direkt ausführen (z. B. f2ban-bans)." >&2
    return 1 2>/dev/null || exit 1
fi

set -euo pipefail

PATTERN=""
JAIL_FILTER=""
COUNT_ONLY=0
LIST_JAILS=0
UNBAN_IP=""

# Farben nur aktivieren, wenn die Ausgabe an ein Terminal geht
if [[ -t 1 ]]; then
    C_RESET=$'\e[0m'
    C_BOLD=$'\e[1m'
    C_GREEN=$'\e[32m'
    C_YELLOW=$'\e[33m'
    C_RED=$'\e[31m'
    C_BLUE=$'\e[34m'
else
    C_RESET=""; C_BOLD=""; C_GREEN=""; C_YELLOW=""; C_RED=""; C_BLUE=""
fi

usage() {
    echo "Verwendung: $(basename "$0") [-p Muster] [-j Jail] [-c] [-l] [-u IP] [-h]"
    echo
    echo "  -p MUSTER    Gesperrte IPs per Regex filtern, z. B. '^92\.' oder '92.*'"
    echo "  -j JAIL      Nur diese Jail statt aller Jails anzeigen/verwenden"
    echo "  -c           Nur die Anzahl gesperrter IPs pro Jail ausgeben"
    echo "  -l           Nur die aktiven Jails auflisten und beenden"
    echo "  -u IP        Diese IP entsperren (alle Jails, oder nur -j Jail)"
    echo "  -h           Diese Hilfe anzeigen"
    exit 1
}

while getopts ":p:j:clu:h" opt; do
    case "$opt" in
        p) PATTERN="$OPTARG" ;;
        j) JAIL_FILTER="$OPTARG" ;;
        c) COUNT_ONLY=1 ;;
        l) LIST_JAILS=1 ;;
        u) UNBAN_IP="$OPTARG" ;;
        h) usage ;;
        \?) echo "Unbekannte Option: -$OPTARG" >&2; usage ;;
        :) echo "Option -$OPTARG benötigt ein Argument." >&2; usage ;;
    esac
done

if [[ "$(id -u)" -ne 0 ]]; then
    echo "Dieses Script muss als root laufen (sudo verwenden)." >&2
    exit 1
fi

if ! command -v fail2ban-client >/dev/null 2>&1; then
    echo "fail2ban-client wurde nicht gefunden. Ist fail2ban installiert?" >&2
    exit 1
fi

ALL_JAILS="$(fail2ban-client status | sed -n 's/^.*Jail list:[[:space:]]*//p' | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | sed '/^$/d')"

if [[ "$LIST_JAILS" -eq 1 ]]; then
    echo "${C_BOLD}Aktive Jails:${C_RESET}"
    echo "$ALL_JAILS" | sed 's/^/  /'
    exit 0
fi

# IPv4-Liste numerisch nach Oktetten sortieren und Duplikate entfernen
sort_ips() {
    awk '!seen[$0]++' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n
}

# Wandelt ein einfaches Shell-Muster wie "92.*" in eine brauchbare Regex um.
normalize_pattern() {
    local p="$1"
    if [[ "$p" == *'*' ]]; then
        p="${p%\*}"
        p="^${p//./\\.}"
    fi
    echo "$p"
}

if [[ -n "$PATTERN" ]]; then
    PATTERN="$(normalize_pattern "$PATTERN")"
fi

if [[ -n "$JAIL_FILTER" ]]; then
    JAILS="$JAIL_FILTER"
else
    JAILS="$ALL_JAILS"
fi

# --- IP entsperren und beenden ---
if [[ -n "$UNBAN_IP" ]]; then
    FOUND=0
    for jail in $JAILS; do
        [[ -z "$jail" ]] && continue
        if fail2ban-client set "$jail" unbanip "$UNBAN_IP" >/dev/null 2>&1; then
            echo "${C_GREEN}✓${C_RESET} $UNBAN_IP aus Jail '${C_BOLD}$jail${C_RESET}' entsperrt"
            FOUND=1
        fi
    done
    if [[ "$FOUND" -eq 0 ]]; then
        echo "${C_RED}✗${C_RESET} $UNBAN_IP war in keiner geprüften Jail gesperrt." >&2
        exit 1
    fi
    exit 0
fi

# --- Normale Anzeige ---
TOTAL=0

for jail in $JAILS; do
    [[ -z "$jail" ]] && continue

    STATUS="$(fail2ban-client status "$jail" 2>/dev/null || true)"
    if [[ -z "$STATUS" ]]; then
        echo "Jail '$jail' nicht gefunden, wird übersprungen." >&2
        continue
    fi

    IP_LINE="$(echo "$STATUS" | sed -n 's/^.*Banned IP list:[[:space:]]*//p')"

    if [[ -n "$PATTERN" ]]; then
        IPS="$(echo "$IP_LINE" | tr ' ' '\n' | sed '/^$/d' | grep -E "$PATTERN" || true)"
    else
        IPS="$(echo "$IP_LINE" | tr ' ' '\n' | sed '/^$/d')"
    fi

    if [[ -n "$IPS" ]]; then
        IPS="$(echo "$IPS" | sort_ips)"
    fi

    IP_COUNT=$(echo "$IPS" | sed '/^$/d' | wc -l)
    [[ -z "$IPS" ]] && IP_COUNT=0

    TOTAL=$((TOTAL + IP_COUNT))

    if [[ "$COUNT_ONLY" -eq 1 ]]; then
        printf "%-20s ${C_YELLOW}%d${C_RESET}\n" "$jail" "$IP_COUNT"
    else
        if [[ "$IP_COUNT" -gt 0 ]]; then
            echo "${C_BLUE}${C_BOLD}=== $jail ($IP_COUNT) ===${C_RESET}"
            echo "$IPS"
        fi
    fi
done

if [[ "$COUNT_ONLY" -eq 1 ]]; then
    echo "-----"
    printf "%-20s ${C_BOLD}%d${C_RESET}\n" "TOTAL" "$TOTAL"
elif [[ "$TOTAL" -eq 0 ]]; then
    echo "Keine gesperrten IPs gefunden (bei den gewählten Filtern)."
fi
